SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_APPROVAL_CHANNEL=#incidents
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
OPA_URL=http://opa:8181
PROM_MCP=http://prom-mcp:8080
LOKI_MCP=http://loki-mcp:8080
K8S_MCP=http://k8s-mcp:8080
# --- LLM Backend (first one wins) ---
# Option 1: Groq (FREE) — get key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key
AGENT_MODEL=llama-3.3-70b-versatile

# Option 2: Anthropic (needs credits)
# ANTHROPIC_API_KEY=sk-ant-api03-...
# AGENT_MODEL=claude-haiku-4-5-20251001

# OpenTelemetry — sends traces to local OTel Collector → Tempo → Grafana
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=athena-agent

# Grafana URL for trace links in Slack messages
GRAFANA_URL=http://localhost:3000
